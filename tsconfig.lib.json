{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "outDir": "dist-lib/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/astro",
    "src/geometry",
    "src/lib",
    "src/sim",
    "src/render",
    "src/ui",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/three",
    "src/dom",
    "src/vue",
    "src/svelte"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
