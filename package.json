{
  "name": "skydial",
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "check": "npm run lint && npm test && npm run build && npm run build:lib && npm run typecheck:consumer && npm run check:package && npm run build:consumer:lcd",
    "build:consumer": "npm run build:lib && vite build -c vite.consumer.config.ts",
    "preview:consumer": "vite preview -c vite.consumer.config.ts --host 127.0.0.1 --port 4175",
    "test:browser": "npm run build:consumer && playwright test",
    "typecheck:consumer": "tsc -p tests/types/tsconfig.json && tsc -p tsconfig.site.json",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build:lib",
    "lint:package": "publint --strict",
    "lint:types": "attw --pack . --profile esm-only",
    "build:docs": "npm run build:lib && vite build -c vite.site.config.ts && package-site build",
    "check:docs": "npm run build:docs && package-site check",
    "docs": "npm run build:docs && node scripts/serve-docs.mjs",
    "test:install": "node scripts/check-install.mjs",
    "test:release": "npm run check && npm run lint:package && npm run lint:types && npm run test:install && npm run check:docs && npm run test:browser && npm run test:docs",
    "prepublishOnly": "node scripts/release-guard.mjs && npm run check && npm run lint:package && npm run lint:types",
    "test:docs": "playwright test -c playwright.docs.config.ts",
    "build:consumer:lcd": "vite build -c vite.lcd.config.ts && node scripts/check-lcd.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "package-site": "github:tbudin/package-site#v0.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "three": "^0.187.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./astro": {
      "types": "./dist-lib/types/astro/index.d.ts",
      "import": "./dist-lib/astro.js"
    },
    "./react": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/react.js"
    },
    "./three": {
      "types": "./dist-lib/types/three/index.d.ts",
      "import": "./dist-lib/three.js"
    },
    "./style.css": {
      "types": "./dist-lib/style.d.ts",
      "default": "./dist-lib/skydial.css"
    },
    "./clock": {
      "types": "./dist-lib/types/sim/index.d.ts",
      "import": "./dist-lib/clock.js"
    },
    "./dom": {
      "types": "./dist-lib/types/dom/index.d.ts",
      "import": "./dist-lib/dom.js"
    },
    "./vue": {
      "types": "./dist-lib/types/vue/index.d.ts",
      "import": "./dist-lib/vue.js"
    },
    "./svelte": {
      "types": "./dist-lib/types/svelte/index.d.ts",
      "import": "./dist-lib/svelte.js"
    },
    "./package.json": "./package.json",
    "./pickers": {
      "types": "./dist-lib/types/lib/pickers.d.ts",
      "import": "./dist-lib/pickers.js"
    },
    "./picker.css": {
      "types": "./dist-lib/style.d.ts",
      "default": "./dist-lib/picker.css"
    },
    "./lcd": {
      "types": "./dist-lib/types/lib/lcd.d.ts",
      "import": "./dist-lib/lcd.js"
    }
  },
  "author": {
    "name": "Thomas Budin",
    "email": "31727129+tbudin@users.noreply.github.com",
    "url": "https://github.com/tbudin"
  },
  "description": "Celestial date and time pickers, clocks and widgets with 3D and LCD styles for React, Vue, Svelte and vanilla JavaScript.",
  "files": [
    "dist-lib",
    "README.md",
    "docs",
    "public/textures/ATTRIBUTION.md",
    "public/textures/LICENSE-solarsystemscope.txt",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbudin/skydial.git"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "three": "^0.187.0",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "license": "MIT",
  "keywords": [
    "orrery",
    "celestial",
    "astronomy",
    "clock",
    "date-picker",
    "time-picker",
    "widgets",
    "three",
    "react",
    "vue",
    "svelte"
  ],
  "homepage": "https://tbudin.github.io/skydial/",
  "bugs": {
    "url": "https://github.com/tbudin/skydial/issues"
  },
  "types": "./dist-lib/types/lib/index.d.ts",
  "module": "./dist-lib/react.js",
  "main": "./dist-lib/react.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
